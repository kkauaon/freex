[Unit]
Description=FREEX web (Next.js)
After=network.target

[Service]
User=freex
WorkingDirectory=/srv/freex
Environment=NODE_ENV=production
ExecStart=/usr/bin/env pnpm --filter @freex/web start
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Next.js writes its cache next to the build
ReadWritePaths=/srv/freex/apps/web/.next

[Install]
WantedBy=multi-user.target
