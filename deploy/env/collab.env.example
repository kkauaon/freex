# /etc/freex/collab.env  (chmod 640, owner root:freex)
PORT=3002
HOST=127.0.0.1
# the exact origin of the web app, no trailing slash; several separated by commas
WEB_ORIGIN=https://app.example.com
COLLAB_DATA_DIR=/var/lib/freex/collab
# Caddy runs on this machine and sets X-Forwarded-For
TRUST_PROXY=true
